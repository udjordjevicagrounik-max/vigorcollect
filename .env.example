# Copy to .env and fill in. Never commit .env (rule 9). No values here on purpose.
# Quote values that contain spaces (PRODUCT_NAME="..."): scripts source this file in bash.

# Product name shown in UI/emails/PDFs (rule 21) — the commercial name is not decided yet.
PRODUCT_NAME=

# Postgres superuser (container bootstrap only — the app never uses it)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Host interface for published ports. Default 127.0.0.1; on the Elestio dev server use
# 172.17.0.1 (docker0) so the dev container can reach them — never 0.0.0.0.
DB_BIND_HOST=

# Role passwords used by db/init/01-roles.sh
APP_DB_PASSWORD=
MIGRATE_DB_PASSWORD=
# Job runner role vigor_worker (scripts/create-service-roles.sh, before migration 007; ADR 0005)
WORKER_DB_PASSWORD=
# Backup / restore-test roles (same script): vigor_backup reads only, vigor_restore owns its
# scratch database. Never the superuser for backups.
BACKUP_DB_PASSWORD=
RESTORE_DB_PASSWORD=

# Host-side connection strings (dev server, scripts/migrate.sh, tests)
# DATABASE_URL         → role vigor_app      (RLS applies; app runtime)
# MIGRATE_DATABASE_URL → role vigor_migrate  (migrations only)
# WORKER_DATABASE_URL  → role vigor_worker   (worker process only: outbox, pg-boss)
DATABASE_URL=
MIGRATE_DATABASE_URL=
WORKER_DATABASE_URL=

# PII master key(s), "1:<base64 32 bytes>[,2:...]" — wraps subject_keys (ADR 0003, rule 28).
# Generate per environment (docs/runbook.md "PII master ključ"); vault only, never in backups.
PII_MASTER_KEYS=

# Better Auth (ADR 0004). Secret: >= 32 random bytes, generated per environment outside the
# chat (docs/runbook.md "Auth"); signs cookies and encrypts TOTP secrets. URL = public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Cloudflare Turnstile (rule 27, ADR 0006): login, password reset, invitation. Both or none.
# Production WITHOUT them refuses to start; dev without them skips the check (logged).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Dev only: password for the seeded tenant admins (seed skips sign-in identities if empty).
SEED_ADMIN_PASSWORD=

# Optional — golden DB tests. Default: the URLs above with database "<POSTGRES_DB>_test".
TEST_DATABASE_URL=
TEST_MIGRATE_DATABASE_URL=
TEST_WORKER_DATABASE_URL=

# Optional
APP_PORT=
APP_BIND_HOST=
APP_VERSION=

# --- Ops (task 1.7) — all optional; empty = off / log only -------------------------------------
# Sentry (app + worker): errors with request id tag, PII scrubbed through pii_field_registry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Alarms: Telegram bot and/or Slack incoming webhook (vault values; never in the repo).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_SLACK_WEBHOOK_URL=
# Worker: app health URL for the "health red twice" alarm (compose sets http://app:3000/health).
APP_HEALTH_URL=
# Backup (scripts/backup.sh) as vigor_backup and restore test (scripts/restore-test.sh) as
# vigor_restore — both required; there is no superuser fallback.
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
BACKUP_DIR=
# Off-site copy (S3-compatible) — used only when rclone or aws cli is installed.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# --- Documents (task 3.2 / 3.3) ----------------------------------------------------------------
# Encrypted document files (HTML + PDF). Compose sets /srv/documents (volume "documents") for app
# and worker; on the host (tests, scripts) empty = <repo>/data/documents.
DOCUMENTS_DIR=
# Chromium for HTML → PDF — only the worker image has it (compose sets /usr/bin/chromium). Empty
# on a host without Chromium = PDFs are not rendered (logged), documents stay HTML previews.
CHROMIUM_PATH=
# --- Risk providers (task 4.3) ------------------------------------------------------------------
# CheckPoint trial key (vault / Elestio env panel; never in the chat or the repo). Empty = the
# provider reports not_configured and the score uses internal signals only.
CHECKPOINT_API_KEY=
# Post-deploy smoke (scripts/smoke.sh): a tenant with at least one user; worker health URL.
SMOKE_TENANT_ID=
WORKER_HEALTH_URL=
