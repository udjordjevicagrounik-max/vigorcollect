# Copy to .env and fill in. Never commit .env (rule 9). No values here on purpose.
# Quote values that contain spaces (PRODUCT_NAME="..."): scripts source this file in bash.

# Product name shown in UI/emails/PDFs (rule 21) — the commercial name is not decided yet.
PRODUCT_NAME=

# Postgres superuser (container bootstrap only — the app never uses it)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Host interface for published ports. Default 127.0.0.1; on the Elestio dev server use
# 172.17.0.1 (docker0) so the dev container can reach them — never 0.0.0.0.
DB_BIND_HOST=

# Role passwords used by db/init/01-roles.sh
APP_DB_PASSWORD=
MIGRATE_DB_PASSWORD=

# Host-side connection strings (dev server, scripts/migrate.sh, tests)
# DATABASE_URL         → role vigor_app      (RLS applies; app runtime)
# MIGRATE_DATABASE_URL → role vigor_migrate  (migrations only)
DATABASE_URL=
MIGRATE_DATABASE_URL=

# PII master key(s), "1:<base64 32 bytes>[,2:...]" — wraps subject_keys (ADR 0003, rule 28).
# Generate per environment (docs/runbook.md "PII master ključ"); vault only, never in backups.
PII_MASTER_KEYS=

# Optional — golden DB tests. Default: the URLs above with database "<POSTGRES_DB>_test".
TEST_DATABASE_URL=
TEST_MIGRATE_DATABASE_URL=

# Optional
APP_PORT=
APP_BIND_HOST=
APP_VERSION=
